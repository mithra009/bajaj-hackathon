# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# Security
# Server authentication token (required for API access)
API_KEY=fd53cda9e372cc74319d047c60acdcc06e62e7e5550a92d842c425b82df84e4d
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=*

# Model Configuration
# Base model to use for text generation
MODEL_NAME=gemini-2.5-flash-lite
# Model to use for generating embeddings
EMBEDDING_MODEL=text-embedding-3-small
# Maximum number of tokens to generate
MAX_TOKENS=8196
# Maximum context length for the model
MAX_CONTEXT_LENGTH=4000
# Sampling temperature (0.0 to 1.0)
TEMPERATURE=0.1
# Nucleus sampling parameter (0.0 to 1.0)
TOP_P=0.95
# Top-k sampling parameter
TOP_K=40

# API Keys
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Note: Gemini API keys are hardcoded in the application

# Rate Limiting
# Maximum number of concurrent queries
MAX_CONCURRENT_QUERIES=10
# Maximum number of concurrent embedding generations
MAX_CONCURRENT_EMBEDDINGS=5
# Maximum requests per minute per API key
RATE_LIMIT_PER_MINUTE=60

# Timeouts (in seconds)
# Timeout for API calls
API_TIMEOUT=30
# Timeout for embedding generation
EMBEDDING_TIMEOUT=60
# Timeout for document downloads
DOWNLOAD_TIMEOUT=120

# Document Processing
# Maximum document size in MB
MAX_DOCUMENT_SIZE_MB=20
# Size of text chunks for processing
CHUNK_SIZE=1000
# Overlap between chunks
CHUNK_OVERLAP=200

# Caching
# Enable/disable response caching
ENABLE_CACHE=true
# Cache time-to-live in seconds (24 hours)
CACHE_TTL=86400

# Logging
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# Log message format
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# Environment
# Enable debug mode (not recommended in production)
DEBUG=false
# Current environment (development, staging, production)
ENVIRONMENT=production